{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trivianinstitute.org/schemas/tria-diachronic-sovereignty/relational-state.schema.json",
  "title": "TRIA Diachronic Sovereignty Relational State",
  "description": "Draft machine-readable representation of governance-relevant relational state. This schema is a specification precursor, not a validated production standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["relationship_id", "participants", "lifecycle_status", "updated_at"],
  "properties": {
    "relationship_id": {"type": "string", "minLength": 1},
    "participants": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["engage", "deepen", "stabilize", "rest", "dormant", "renew", "transform", "dissolved", "unknown"]
    },
    "consent_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "authority_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "shared_claim_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dispute_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "uncertainty_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "continuity_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved_difference_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "transformation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy_version": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  }
}
