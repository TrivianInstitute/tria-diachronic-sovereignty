{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trivianinstitute.org/schemas/tria-diachronic-sovereignty/continuity-attestation.schema.json",
  "title": "TRIA Continuity Attestation",
  "description": "Draft schema for representing continuity across material change without asserting perfect identity persistence. A continuity attestation is an attributable governance claim, not proof of identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_id", "relationship_id", "predecessor_ref", "successor_ref", "event_type", "issuer_ref", "status", "recorded_at"],
  "properties": {
    "attestation_id": {"type": "string", "minLength": 1},
    "relationship_id": {"type": "string", "minLength": 1},
    "predecessor_ref": {"type": "string", "minLength": 1},
    "successor_ref": {"type": "string", "minLength": 1},
    "subject_actor": {
      "type": ["string", "null"],
      "description": "Optional higher-level participant identity under which predecessor and successor are being evaluated."
    },
    "event_type": {
      "type": "string",
      "enum": ["model_upgrade", "model_replacement", "memory_migration", "vendor_migration", "architecture_change", "capability_change", "human_change", "rebaseline", "other"]
    },
    "issuer_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Actor, process, or institution issuing the attestation. Issuance does not make the attestation authoritative by default."
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "disputed", "superseded", "withdrawn", "unknown"]
    },
    "prior_state_ref": {"type": ["string", "null"]},
    "new_state_ref": {"type": ["string", "null"]},
    "persisted_elements": {"type": "array", "items": {"type": "string"}},
    "changed_elements": {"type": "array", "items": {"type": "string"}},
    "removed_elements": {"type": "array", "items": {"type": "string"}},
    "unknown_elements": {"type": "array", "items": {"type": "string"}},
    "active_commitment_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expired_permission_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reconsent_required_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dispute_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "uncertainty_note": {"type": ["string", "null"]},
    "provenance_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": ["string", "null"]},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
